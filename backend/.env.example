# Copy this file to .env and fill in your REAL values there.
# Never paste real secrets into chat, into server.js, or commit .env to git.

# From your Plaid dashboard (dashboard.plaid.com)
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=

# From console.anthropic.com (this is a separate key from claude.ai chat access)
ANTHROPIC_API_KEY=

# Local server port
PORT=4000
